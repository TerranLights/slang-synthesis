{"nodes": [{"id": "established_080_critical_companion_beowulf_pt03_document", "label": "A Critical Companion to Beowulf, Ch.7 \"Words and Deeds\" (Orchard 2003)", "file_type": "document", "source_file": "established/080_critical_companion_beowulf_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Andy Orchard", "contributor": null}, {"id": "established_080_critical_companion_beowulf_pt03_speech_patterning_system", "label": "Speech as a patterned, choreographed structural system", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Part I speeches overwhelmingly come in answered pairs (25/30); in Part II none of 9 speeches receives a reply and three are interrupted \u2014 speech-act patterning functions as a register-marking device distinguishing the poem's two discourse modes."}, {"id": "established_080_critical_companion_beowulf_pt03_courtly_qa_triad", "label": "Courtly question-answer triad as a reusable discourse template", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coastguard and Wulfgar exchanges each follow an identical 3-part ask/state-role/admire template, mirrored by Beowulf's identify-lord/state-name/state-errand reply, sharing a fixed 4-verb introductory skeleton independent of lexical filling."}, {"id": "established_080_critical_companion_beowulf_pt03_imperative_female_register", "label": "Imperative mood as a female-speech-register marker", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wealhtheow's two speeches are dense in imperative verb forms (4 in 6 lines, 7 across the second speech), projecting royal authority through directive speech acts, in pointed contrast to receiving no verbal reply."}, {"id": "established_080_critical_companion_beowulf_pt03_gnomic_sentences", "label": "Gnomic/proverbial sentences as a recurring rhetorical device", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "General timeless-present-tense assertions inserted into specific narrative moments lend 'a sense of conviction, if not truth'; the same mortality-themed gnomic content recurs almost verbatim at two separated points in the poem."}, {"id": "established_080_critical_companion_beowulf_pt03_first_person_density", "label": "First-person reference density as a characterization device", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "28 first-person references in a single 49-line speech; countable pronoun-person distribution used as quantifiable evidence for characterizing Beowulf as individualistic."}, {"id": "established_080_critical_companion_beowulf_pt03_thought_word_deed_triad", "label": "The 'thought, word, and deed' triad of ideal heroic conduct", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A recurring formulaic triad \u2014 assessment in mod, skill in word, capability in deed \u2014 identified by Orchard (citing Sims-Williams) as a broader Insular/Irish-influenced convention; the chapter's own title names this larger thematic polarity."}, {"id": "established_080_critical_companion_beowulf_pt03_mathelian", "label": "ma\u00feelian (pret. ma\u00feelode) 'to speak formally/ceremonially'", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_080_critical_companion_beowulf_pt03_andswarode", "label": "andswarode 'answered' (introductory-verb variant, Table IV)", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_080_critical_companion_beowulf_pt03_wordhord_onleac", "label": "wordhord onleac 'unlocked his word-hoard' (began to speak, Beowulf context)", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_080_critical_companion_beowulf_pt03_for_wlenco", "label": "for wlenco 'out of pride/rashness' (identical formula, shifting valence across three speakers)", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_080_critical_companion_beowulf_pt03_wyrd", "label": "wyrd 'fate' (Beowulf's gnomic formulas)", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_080_critical_companion_beowulf_pt03_hondscio_pun", "label": "Hondscio 'glove' (slain retainer's name punning on Grendel's man-eating glof)", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "es