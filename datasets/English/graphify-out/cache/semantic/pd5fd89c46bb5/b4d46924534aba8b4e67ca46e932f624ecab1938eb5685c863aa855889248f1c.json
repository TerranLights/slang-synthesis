{"nodes": [{"id": "established_088_grammar_of_english_grammars_pt10_document", "label": "Grammar of English Grammars pt10 (Appendixes I-IV)", "file_type": "document", "source_file": "established/088_grammar_of_english_grammars_pt10.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null}, {"id": "established_088_grammar_of_english_grammars_pt10_appendix1_sounds_of_letters", "label": "Appendix I: Of the Sounds of the Letters", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt10.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null}, {"id": "established_088_grammar_of_english_grammars_pt10_appendix2_derivation_of_words", "label": "Appendix II: Of the Derivation of Words", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt10.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null}, {"id": "established_088_grammar_of_english_grammars_pt10_appendix2_horne_tooke_etymology", "label": "Horne Tooke's etymological theory of 'the'/'that' (Diversions of Purley), rejected by Brown", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt10.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null, "rationale": "Tooke claims 'the' derives from Saxon 'thean' (to take) and 'that' is its past participle; Brown rejects this as insufficiently evidenced, preferring 'the' from Anglo-Saxon 'se' (from 'seon', to see), citing Bosworth's dictionary against Tooke."}, {"id": "established_088_grammar_of_english_grammars_pt10_appendix3_qualities_of_style", "label": "Appendix III: Of the Qualities of Style (Purity, Propriety, Precision, Perspicuity, Unity, Strength)", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt10.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null}, {"id": "established_088_grammar_of_english_grammars_pt10_appendix3_propriety_slang_examples", "label": "Propriety Precept I: named 1851-era colloquial/slang forms flagged as substandard ('Thinks I to myself', 'By jinkers', 'absquatulate')", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt10.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null, "rationale": "A rare instance of Brown directly naming real period colloquial/slang forms (rather than literary misquotations) as examples cultivated prose should avoid -- a primary-source snapshot of 1851 American English's slang boundary; several flagged coinages ('flutteration', 'absquatulate') are independently attested genuine period slang."}, {"id": "established_088_grammar_of_english_grammars_pt10_appendix4_poetic_diction", "label": "Appendix IV: Of Poetic Diction (article-dropping, clipping common nouns, enallage, postposed-self)", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt10.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null, "rationale": "Clipping common nouns for poetic register (amaze, corse, eve, fount, helm, morn, plaint, weal) is a direct formal parallel to the Figures of Etymology clipping mechanisms, here shown operating as a register-marking device rather than a general phonological process."}, {"id": "established_088_grammar_of_english_grammars_pt10_suffix_inventory_noun", "label": "Noun-forming suffix inventory (-ship, -dom, -ian, -kin/-let diminutives, -ist, -ment, -er/-ee, etc.)", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt10.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null}, {