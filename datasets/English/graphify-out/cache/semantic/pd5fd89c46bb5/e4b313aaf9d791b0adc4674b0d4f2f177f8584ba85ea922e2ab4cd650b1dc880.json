{"nodes": [{"id": "established_089_concise_anglo_saxon_dictionary_pt01_document", "label": "A Concise Anglo-Saxon Dictionary (Clark Hall / Meritt), sampled extraction", "file_type": "document", "source_file": "established/089_concise_anglo_saxon_dictionary_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": "J.R. Clark Hall", "contributor": "Herbert D. Meritt"}, {"id": "established_089_concise_anglo_saxon_dictionary_pt01_headword_a", "label": "\u0101 'always, ever' -- first headword of the dictionary", "file_type": "concept", "source_file": "established/089_concise_anglo_saxon_dictionary_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": "J.R. Clark Hall", "contributor": null}, {"id": "established_089_concise_anglo_saxon_dictionary_pt01_hlaford_compound_family", "label": "hl\u0101f- 'loaf/bread' compound family (hl\u0101ford 'lord', hl\u0101f\u00e6ta 'dependant', hl\u0101fm\u00e6sse 'Lammas')", "file_type": "concept", "source_file": "established/089_concise_anglo_saxon_dictionary_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": "J.R. Clark Hall", "contributor": null, "rationale": "All three keep the lord/household/harvest-festival semantic field anchored concretely in 'bread', a core subsistence noun generating an entire social-structure vocabulary cluster via compounding."}, {"id": "established_089_concise_anglo_saxon_dictionary_pt01_wund_wundor_family", "label": "wund-/wundor- 'wound/wonder' shared-root cluster", "file_type": "concept", "source_file": "established/089_concise_anglo_saxon_dictionary_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": "J.R. Clark Hall", "contributor": null}, {"id": "established_089_concise_anglo_saxon_dictionary_pt01_symbel_family", "label": "symbel- 'feast' base noun generating moralizing excess-adjective (symbelg\u0101l 'wanton with feasting')", "file_type": "concept", "source_file": "established/089_concise_anglo_saxon_dictionary_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": "J.R. Clark Hall", "contributor": null, "rationale": "A derivation pattern ('noun of an activity' -> 'adjective meaning excessive in that activity') structurally comparable to how modern slang often derives pejorative adjectives from nouns naming an activity or substance."}, {"id": "established_089_concise_anglo_saxon_dictionary_pt01_dialect_marking_system", "label": "List of Signs dialect-marking codes (N=Northumbrian, M=Mercian, A=Anglian, K/EK=Kentish, LWS, NG=Northumbrian Gospels)", "file_type": "concept", "source_file": "established/089_concise_anglo_saxon_dictionary_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": "J.R. Clark Hall", "contributor": null}, {"id": "established_089_concise_anglo_saxon_dictionary_pt01_poetic_dagger_marker", "label": "\u2020 dagger marker: 'occurs only or mainly in poetical texts' register tag", "file_type": "concept", "source_file": "established/089_concise_anglo_saxon_dictionary_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": "J.R. Clark Hall", "contributor": null}, {"id": "established_089_concise_anglo_saxon_dictionary_pt01_supplement_addenda_format", "label": "Meritt's Supplement: terse corrections-and-additions format distinct from the main dictionary body", "file_type": "concept", "source_file": "established/089_concise_anglo_saxon_dictionary_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Herbert D. Meritt", "contributor": null}, {"id": "established_089_concise_anglo_saxon_dictionary_pt01_ocr_cipher_gotcha", "label": "Non-cipher OCR character misrecognition + two-column block-order scrambling (ABBYY FineReader 8.0)", "file_type": "concept", "source_file": "established/089_concise_anglo_saxon_dictionary_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlike the Korean/Russian font-substitution ciphers documented elsewhere in this project, no consistent 1:1 or offset mapping was found here -- macron vowels garble differently in different tokens, consistent with genuine OCR misrecognition rather than a decodable font cipher; resolved by cross-checking every entry against rendered page images rather than trusting the raw or -layout pdftotext output."}, {"id": "established_089_concise_anglo_saxon_dictionary_pt01_un_negative_prefix", "label": "un- negative prefix, highly productive (unsw\u0113te, untr\u0113owf\u00e6st)", "file_type": "concept", "source_file": "established/089_concise_anglo_saxon_dictionary_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": "J.R. Clark Hall", "contributor": null}, {"id": "established_089_concise_anglo_saxon_dictionary_pt01_nithing_pejorative_compound", "label": "mete-n\u012b\u00f0ing 'food-niggard' -- n\u012b\u00f0ing as a severe legal/social-disgrace term", "file_type": "concept", "source_file": "established/089_concise_anglo_saxon_dictionary_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": "J.R. Clark Hall", "contributor": null, "rationale": "n\u012b\u00f0ing was a term of severe legal/social disgrace in Old English and Old Norse law (an outlawed, honorless person), so this compound reads closer to 'a disgraceful miser about food' than a neutral descriptor -- flagged as worth a closer look in any future mechanics-analysis pass on OE pejorative compounding."}], "edges": [{"source": "established_089_concise_anglo_saxon_dictionary_pt01_document", "target": "established_089_concise_anglo_saxon_dictionary_pt01_headword_a", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/089_concise_anglo_saxon_dictionary_pt01.md", "source_location": null, "weight": 1.0}, {"source": "established_089_concise_anglo_saxon_dictionary_pt01_docume