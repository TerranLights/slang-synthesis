{"nodes": [{"id": "established_071_longman_grammar_practice_pt10_document", "label": "Longman Grammar Practice Ch.10: Be, Have, Do", "file_type": "document", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": null, "source_url": null, "captured_at": null, "author": "L. G. Alexander", "contributor": null}, {"id": "established_071_longman_grammar_practice_pt10_be_imperative_adjective_type", "label": "'Be' + adjective imperative restricted to passing-behaviour adjectives (not states)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.142", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Be careful!' works because carefulness is controllable/temporary conduct; '*Be hungry!*' is impossible because hungry describes an inherent state, not controllable behaviour."}, {"id": "established_071_longman_grammar_practice_pt10_arent_i", "label": "'Aren't I' as the conventional negative-question substitute for 'Am I not'", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.142", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt10_be_progressive_temporary", "label": "Progressive 'be' (is being/was being) for temporary/deliberate behaviour", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.144", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt10_be_perfect_adjective_noun", "label": "'Has/have/had been' + adjectives and nouns, perfect-tense rule", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.144", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt10_have_been_vs_have_gone", "label": "'Have been' (visited and returned) vs 'have gone' (still away)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.144", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt10_have_been_since_for", "label": "'How long...?' + 'have been' answered with since/for", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.145", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt10_there_be_existential", "label": "Existential 'there' + 'be' preferred over 'it has/it is'", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.146", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt10_there_vs_it", "label": "'There is' (introduces referent) vs 'it is' (supplies further detail) discourse pattern", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.146", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt10_be_synonym_verbs", "label": "Be-synonym verbs for uncertainty (appear, feel, look, seem, smell, sound, taste)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.148", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt10_to_be_dropping", "label": "Dropping 'to be' after appear/seem, except before afraid/asleep/awake", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.148", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt10_process_verbs", "label": "Process verbs for change of state (become, come, fall, get, go, grow, run, turn, wear)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.149", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt10_have_got_possession", "label": "'Have'/'have got' = possess vs 'have got' = obtain, surface-form ambiguity", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.150", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The identical surface form 'have got' is ambiguous between present-possession and the present-perfect of 'get' (=obtained); only context (a recency adverb like 'just', or an ongoing-possession reading) disambiguates."}, {"id": "established_071_longman_grammar_practice_pt10_have_eat_enjoy", "label": "'Have' meaning eat/enjoy/experience, behaving as an ordinary dynamic verb", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.152", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt10_do_auxiliary_full_verb", "label": "'Do' as auxiliary and as full verb (perform an activity), plus pro-verb and idiomatic uses", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.154", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt10_do_vs_make", "label": "'Do' (be engaged in activity) vs 'make' (create) fixed collocations", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.155", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt10_cross_linguistic_be_requirement", "label": "English structurally requires 'be' where other languages don't ('I am hungry', not '*I have hunger')", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.143", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "established_071_longman_grammar_practice_pt10_document", "target": "established_071_longman_grammar_practice_pt10_be_imperative_adjective_type", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.142", "weight": 1.0}, {"source": "established_071_longman_grammar_practice_pt10_document", "target": "established_071_longman_grammar_practice_pt10_arent_i", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.142", "weight": 1.0}, {"source": "established_071_longman_grammar_practice_pt10_document", "target": "established_071_longman_grammar_practice_pt10_be_progressive_temporary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.144", "weight": 1.0}, {"source": "established_071_longman_grammar_practice_pt10_document", "target": "established_071_longman_grammar_practice_pt10_be_perfect_adjective_noun", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/071_longman_grammar_practice_pt10.md", "source_location": "p.144", "weight": 1.0}, {"source": "established_071_longman_grammar_practice_pt10_document", "target": "established_071_