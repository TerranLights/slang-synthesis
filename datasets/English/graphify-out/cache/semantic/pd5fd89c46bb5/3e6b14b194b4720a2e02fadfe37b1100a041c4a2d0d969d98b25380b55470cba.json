ll, "contributor": null}, {"id": "00_book_triage_catalog_garner_bryan_a", "label": "Bryan A. Garner (author)", "file_type": "concept", "source_file": "00_Book_Triage_Catalog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "00_book_triage_catalog_getpedia_wrapper_gotcha", "label": "GetPedia.com Wrapper Masking Scan-Only PDF", "file_type": "concept", "source_file": "00_Book_Triage_Catalog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A scraped GetPedia.com web-portal page was prepended to two otherwise scan-only PDFs, making them look text-bearing from only the first few sampled pages; full-range sampling was required to detect the underlying scan-only status."}, {"id": "00_book_triage_catalog_doc_format_gotcha", "label": "Legacy .doc Format: Two Opposite Outcomes", "file_type": "concept", "source_file": "00_Book_Triage_Catalog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two legacy Composite-Document-File .doc files in this triage had opposite outcomes: the Cambridge Grammar .doc converted cleanly to 161,807 words of real text, while the Guide to Old English .doc was effectively textless (17-byte conversion output) despite being 96MB, its size explained by ~174 embedded JPEG page-scan images. OLE metadata word/character counts predicted both outcomes correctly and should be checked before assuming any .doc converts cleanly."}, {"id": "00_book_triage_catalog_thorn_eth_cipher", "label": "Thorn/Eth (\u00fe/\u00f0) Font-Substitution Cipher", "file_type": "concept", "source_file": "00_Book_Triage_Catalog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u00fe and \u00f0 render as a fixed-substitution cipher (\u00fe\u2192\"\u0192\", \u00f0\u2192\"\u00ea\") in this sampled Old English PDF, the same fixed-substitution-cipher-on-a-subset-of-special-characters pattern already catalogued for Cyrillic and CJK sources, now confirmed on Old English for the first time; only verified in this one file/sample so far, not assumed to hold project-wide."}, {"id": "00_book_triage_catalog_two_column_dictionary_scrambling_gotcha", "label": "Two-Column Dictionary Scrambling (Anglo-Saxon Dictionary)", "file_type": "concept", "source_file": "00_Book_Triage_Catalog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entries in the two-column Concise Anglo-Saxon Dictionary are cross-contaminated mid-line when extracted with a non-column-aware method, compounded by OCR character substitution (e.g. \"6\" for a macron, \"\u0416\" for \"\u00c6\"); the same two-column-glossary interleaving gotcha already documented for Serbian/Croatian/Bosnian, now confirmed on an Old English source. Requires column-aware bounding-box extraction."}, {"id": "00_book_triage_catalog_morphological_typology_english_catalog", "label": "English Morphological Typology: Isolating/Analytic", "file_type": "concept", "source_file": "00_Book_Triage_Catalog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "00_book_triage_catalog_priority_tiers", "label": "Priority Tiers (Tier 0-5)", "file_type": "concept", "source_file": "00_Book_Triage_Catalog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "00_book_triage_catalog_wave_structure_plan", "label": "Recommended Wave Structure (37-item, 7-wave plan)", "file_type": "concept", "source_file": "00_Book_Triage_Catalog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "00_book_triage_catalog_cambridge_english_grammar_in_use_doc", "label": "Cambridge English Grammar in Use (Murphy, .doc)", "file_ty