{"nodes": [{"id": "established_081_old_english_literature_short_intro_pt02_document", "label": "Old English Literature: A Short Introduction, Ch.3-5 (Donoghue 2004)", "file_type": "document", "source_file": "established/081_old_english_literature_short_intro_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Daniel Donoghue", "contributor": null}, {"id": "established_081_old_english_literature_short_intro_pt02_northumbrian_orthography", "label": "Northumbrian dialect orthography vs. West Saxon convention", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Early Northumbrian scribes had not yet adopted eth/thorn and used <u> as a consonant where West Saxon later used <w>; scribes also did not capitalize divine epithets, a period convention rather than disrespect."}, {"id": "established_081_old_english_literature_short_intro_pt02_ruthwell_cross", "label": "Runic Ruthwell Cross excerpt, also marked Northumbrian", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent confirmation, via a different physical artifact (stone vs manuscript), of the same regional/dialectal tagging pattern as C\u00e6dmon's Hymn."}, {"id": "established_081_old_english_literature_short_intro_pt02_formula_christianization", "label": "Formula-template Christianization: building new epithets on pagan patterns", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-Christian oral-poetic formulas were adapted to Christian use by adding an element (all- + mehtig) or substituting a Christianizing term within the existing template (eci dryctin, hefen-ric\u00e6s uard); the underlying template grammar is preserved, only slot-fillers change."}, {"id": "established_081_old_english_literature_short_intro_pt02_uton_grammaticalization", "label": "uton: grammaticalization case study (lexical verb to hortatory auxiliary)", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "uton derives from the subjunctive of witan 'to go' (not witan 'to know'); its lexical meaning dissipated as it was reanalyzed into a hortatory particle construed with an infinitive, while the original lexical verb continued to exist independently."}, {"id": "established_081_old_english_literature_short_intro_pt02_alfred_translation_method", "label": "Alfred's explicit two-mode translation methodology ('word for word' / 'sense for sense')", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alfred names both literal and idiomatic translation modes in the proem to his Consolation of Philosophy translation; his free adaptations (inserted material, substituted personifications like Mod for Boethius) show he leaned toward sense-for-sense in practice."}, {"id": "established_081_old_english_literature_short_intro_pt02_riddle_gender_misdirection", "label": "Grammatical gender exploited for riddle misdirection", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OE's three-way grammatical gender system does not reliably track natural gender/animacy; riddle-poets exploit the mismatch \u2014 a masculine noun like sele 'hall' can take 'he' even of a fish's watery 'hall' \u2014 for deliberate misdirection."}, {"id": "established_081_old_english_literature_short_intro_pt02_caedmons_hymn", "label": "C\u00e6dmon's Hymn (full Northumbrian text, 8 divine epithets)", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_081_old_english_literature_short_intro_pt02_wraetlic", "label": "wr\u00e6tlic 'wondrous, strange' (grammatically ambiguous riddle-opener)", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_081_old_english_literature_short_intro_pt02_sele_gender", "label": "sele 'hall' \u2014 grammatically masculine noun enabling riddle misdirection (fish riddle)", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_081_old_english_literature_short_intro_pt02_raedels", "label": "r\u00e6dels 'riddle' (general OE term for the riddle genre)", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_081_old_english_literature_short_intro_pt02_widsith_wordhord_onleac", "label": "Widsi\u00f0 ma\u00f0olade, wordhord onleac 'Widsith spoke, unlocked his word-hoard' (opening line of Widsith)", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null