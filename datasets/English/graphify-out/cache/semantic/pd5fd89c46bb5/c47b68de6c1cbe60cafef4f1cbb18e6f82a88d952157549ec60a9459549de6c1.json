{"nodes": [{"id": "established_090_guide_to_old_english_document", "label": "A Guide to Old English (Mitchell & Robinson), Part One extraction", "file_type": "document", "source_file": "established/090_guide_to_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Bruce Mitchell and Fred C. Robinson", "contributor": null}, {"id": "established_090_guide_to_old_english_i_mutation", "label": "i-Mutation: pervasive OE sound change fronting/raising stressed vowels before /i/ or /j/", "file_type": "concept", "source_file": "established/090_guide_to_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Bruce Mitchell and Fred C. Robinson", "contributor": null, "rationale": "Direct historical source of MnE irregular plurals (man/men, foot/feet, tooth/teeth, goose/geese, mouse/mice, louse/lice) and of i-mutated comparatives (eald/ieldra/ieldest); the strong-verb gradation system and i-mutation are two independently-visible traces of the same underlying historical mechanism."}, {"id": "established_090_guide_to_old_english_strong_verb_system", "label": "Strong verb system: 7 gradation classes, 4 principal parts, recognition symbols", "file_type": "concept", "source_file": "established/090_guide_to_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Bruce Mitchell and Fred C. Robinson", "contributor": null}, {"id": "established_090_guide_to_old_english_weak_verb_system", "label": "Weak verb system: 3 classes with dental-suffix preterite/past participle", "file_type": "concept", "source_file": "established/090_guide_to_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Bruce Mitchell and Fred C. Robinson", "contributor": null}, {"id": "established_090_guide_to_old_english_preterite_present_verbs", "label": "Preterite-present verbs (\u0101gan, cunnan, magan, m\u014dtan, sculan, \u00feurfan, witan)", "file_type": "concept", "source_file": "established/090_guide_to_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Bruce Mitchell and Fred C. Robinson", "contributor": null, "rationale": "An old strong preterite form repurposed as a present-tense meaning (parallel to Latin 'novi'), with a newly-built weak preterite layered on top -- the direct historical source of the entire MnE modal-auxiliary system (can, may/might, must, shall/should, dare, owe/own/ought, wot/wit)."}, {"id": "established_090_guide_to_old_english_pronoun_dual_system", "label": "Pronoun system: OE preserves a dual number in 1st/2nd person pronouns (wit, \u0121it)", "file_type": "concept", "source_file": "established/090_guide_to_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Bruce Mitchell and Fred C. Robinson", "contributor": null}, {"id": "established_090_guide_to_old_english_noun_declension", "label": "Noun declension: weak vs strong, h-stems, -u-stems, i-mutation nouns, r-stem kinship terms", "file_type": "concept", "source_file": "established/090_guide_to_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Bruce Mitchell and Fred C. Robinson", "contributor": null}, {"id": "established_090_guide_to_old_english_adjective_comparison", "label": "Adjective declension and comparison: regular -ra/-ost, i-mutated, and suppletive patterns", "file_type": "concept", "source_file": "established/090_guide_to_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Bruce Mitchell and Fred C. Robinson", "contributor": null}, {"id": "established_090_guide_to_old_english_compounding_kenning", "label": "Compounding and the kenning (hw\u00e6lwe\u0121 'whale-way', hleahtorsmi\u00fe 'laughter-smith')", "file_type": "concept", "source_file": "established/090_guide_to_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Bruce Mitchell and Fred C. Robinson", "contributor": null, "rationale": "The kenning is a compressed metaphor serving the practical need for alliterative synonyms in formulaic oral-derived verse -- a concrete example of vocabulary generated to serve a metrical/poetic system via compounding plus a formal alliteration constraint."}, {"id": "established_090_guide_to_old_english_word_formation_affixes", "label": "Derivational prefix/suffix catalogue (\u0101-, be-, for-, \u0121e-, un-, wan-; -h\u0101d, -sc\u012bpe, -d\u014dm, -i\u0121, -l\u012b\u010d)", "file_type": "concept", "source_file": "established/090_guide_to_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Bruce Mitchell and Fred C. Robinson", "contributor": null}, {"id": "established_090_guide_to_old_english_syntax_word_order", "label": "Word order: S.V., S...V., V.S. patterns and the case-erosion-driven rise of fixed S.V.O.", "file_type": "concept", "source_file": "established/090_guide_to_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Bruce Mitchell and Fred C. Robinson", "contributor": null, "rationale": "OE's loss of distinct nominative/accusative marking in some paradigms already creates real word-order-dependent ambiguity in attested texts; the book frames the gradual rise of fixed S.V.O. order as directly driven by this erosion of case marking -- word order and inflection as functionally substitutable mechanisms."}, {"id": "established_090_guide_to_old_english_verners_grimms_law", "label": "Grimm's Law and Verner's Law explaining medial-consonant alternations in strong verbs", "file_type": "concept", "source_file": "established/090_guide_to_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Bruce Mitchell and Fred C. Robinson", "contributor": null, "rationale": "Verner's Law outcomes depended on where Proto-Indo-European stress fell, explaining why OE has f\u00e6der 'father' (voiced reflex, second-syllable stress) rather than the expected *f\u00e6\u00feer alongside br\u014d\u00feor 'brother' (voiceless reflex, first-syllable stress); alternants are sometimes later levelled away by analogy, an early instance of the regularizing pressure that later eliminated much of the strong-verb system's internal distinctions."}, {"id": "established_090_guide_to_old_english_resolved_periphrastic_tenses", "label": "Resolved (periphrastic) tenses: incipient participle/infinitive + b\u0113on/habban/modal constructions", "file_type": "concept", "source_file": "established/090_guide_to_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Bruce Mitchell and Fred C. Robinson", "contributor": null}], "edges": [{"source": "established_090_guide_to_old_english_document", "target": "established_090_guide_to_old_english_i_mutation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/090_guide_to_old_english.md", "source_location": null, "weight": 1.0}, {"source": "established_090_guide_to_old_english_document", "target": "established_090_guide_to_old_english_strong_verb_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/090_guide_to_old_english.md", "source_location": null, "weight": 1.0}, {"source": "established_090_guide_to_old_english_document", "target": "established_090_guide_to_old_english_weak_verb_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/090_guide_to_old_english.md", "source_location": null, "weight": 1.0}, {"source": "established_090_guide_to_old_english_document", "target": "established_090_guide_to_old_english_preterite_present_verbs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/090_guide_to_old_english.md", "source_location": null, "weight": 1.0}, {"source": "est