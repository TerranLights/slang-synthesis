{"nodes": [{"id": "established_041_cmos_ch11_foreign_languages_pt06_cmos_source", "label": "CMOS Ch.11 Foreign Languages pt06", "file_type": "document", "source_file": "established/041_cmos_ch11_foreign_languages_pt06.md", "source_location": null, "source_url": null, "captured_at": null, "author": "University of Chicago Press Staff", "contributor": null}, {"id": "established_041_cmos_ch11_foreign_languages_pt06_russian_transliteration_systems_concept", "label": "Russian transliteration: 'linguistic' diacritic-heavy system vs. USBGN general-audience system (11.118)", "file_type": "concept", "source_file": "established/041_cmos_ch11_foreign_languages_pt06.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_041_cmos_ch11_foreign_languages_pt06_russian_capitalization_rule", "label": "Russian capitalization resembles French; geographic designations capitalized only as formal institutions (11.119)", "file_type": "concept", "source_file": "established/041_cmos_ch11_foreign_languages_pt06.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_041_cmos_ch11_foreign_languages_pt06_russian_titles_kursiv_rule", "label": "Russian kursiv (italic) used more sparingly than English italics, never for book titles, in original Cyrillic (11.120)", "file_type": "concept", "source_file": "established/041_cmos_ch11_foreign_languages_pt06.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_041_cmos_ch11_foreign_languages_pt06_russian_quotations_dialogue_rule", "label": "Russian follows French practice: guillemets for quotation, dashes to introduce dialogue lines (11.121)", "file_type": "concept", "source_file": "established/041_cmos_ch11_foreign_languages_pt06.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_041_cmos_ch11_foreign_languages_pt06_russian_suspension_points_rule", "label": "Russian suspension points; exclamation/question mark may substitute for one of three dots (11.122)", "file_type": "concept", "source_file": "established/041_cmos_ch11_foreign_languages_pt06.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_041_cmos_ch11_foreign_languages_pt06_russian_word_division_rules", "label": "Russian word-division rules: indivisible transliteration digraphs, consonant clusters, prefixes, vowels (11.124-11.128)", "file_type": "concept", "source_file": "established/041_cmos_ch11_foreign_languages_pt06.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_041_cmos_ch11_foreign_languages_pt06_south_asian_special_characters_concept", "label": "South Asian transliteration diacritics, with a documented countertrend toward simplification (11.129)", "file_type": "concept", "source_file": "established/041_cmos_ch11_foreign_languages_pt06.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CMOS notes writers increasingly drop diacritics, substituting plain 'sh' and omitting subscript dots/macrons -- an explicit usage-trend annotation."}, {"id": "established_041_cmos_ch11_foreign_languages_pt06_greek_transliteration_rule", "label": "Transliterating Greek: dropped accents, macron for long vowels, iota subscript as on-line 'i' (11.130)", "file_type": "concept", "source_file": "established/041_cmos_ch11_foreign_languages_pt06.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_041_cmos_ch11_foreign_languages_pt06_greek_breathing_marks_concept", "label": "Greek breathing marks: rough (dasia) vs. smooth (psili), required on every initial vowel/diphthong/rho (11.132