 (11.138-11.140)", "file_type": "concept", "source_file": "established/041_cmos_ch11_foreign_languages_pt06.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_041_cmos_ch11_foreign_languages_pt06_mojibake_utf8_as_latin1_cipher", "label": "UTF-8-as-Latin-1 mojibake cipher (this file: priy\u00ebmnik, na\u00eff, oxia byte-verified, varia low-confidence)", "file_type": "concept", "source_file": "established/041_cmos_ch11_foreign_languages_pt06.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One instance (the exact glyph for the Greek midlevel colon/semicolon mark) was genuinely not recoverable and was left undecoded rather than guessed, per spec."}], "edges": [{"source": "established_041_cmos_ch11_foreign_languages_pt06_russian_transliteration_systems_concept", "target": "established_041_cmos_ch11_foreign_languages_pt06_cmos_source", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/041_cmos_ch11_foreign_languages_pt06.md", "source_location": null, "weight": 1.0}, {"source": "established_041_cmos_ch11_foreign_languages_pt06_russian_capitalization_rule", "target": "established_041_cmos_ch11_foreign_languages_pt06_cmos_source", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/041_cmos_ch11_foreign_languages_pt06.md", "source_location": null, "weight": 1.0}, {"source": "established_041_cmos_ch11_foreign_languages_pt06_russian_titles_kursiv_rule", "target": "established_041_cmos_ch11_foreign_languages_pt06_cmos_source", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/041_cmos_ch11_foreign_languages_pt06.md", "source_location": null, "weight": 1.0}, {"source": "established_041_cmos_ch11_foreign_languages_pt06_russian_quotations_dialogue_rule", "target": "est