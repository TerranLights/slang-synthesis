 mechanics-analysis work."}, {"id": "established_074_germanic_languages_pt03_relexification_decreolization", "label": "Relexification and decreolization toward the superstrate", "file_type": "concept", "source_file": "established/074_germanic_languages_pt03.md", "source_location": "\u00a718.2-18.5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_074_germanic_languages_pt03_tok_pisin", "label": "Tok Pisin (Papua New Guinea English-lexifier creole)", "file_type": "concept", "source_file": "established/074_germanic_languages_pt03.md", "source_location": "throughout", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_074_germanic_languages_pt03_middle_english_creole_debate", "label": "Rejected proposal that Middle English itself was a creole", "file_type": "concept", "source_file": "established/074_germanic_languages_pt03.md", "source_location": "\u00a718.1 cont'd, pp.571-585", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Some scholars have proposed treating Middle English as a creole given its massive French/Latin borrowing; the chapter rejects this as undermining Middle English's historical continuity and Germanic identity."}], "edges": [{"source": "established_074_germanic_languages_pt03_doc", "target": "established_074_germanic_languages_pt03_pidgin_creole_definition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/074_germanic_languages_pt03.md", "source_location": null, "weight": 1.0}, {"source": "established_074_germanic_languages_pt03_doc", "target": "established_074_germanic_languages_pt03_creole_genesis_theories", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/074_germanic_languages_pt03.md", "source_location": null, "weight": 1.0}, {"source": "established_074_germanic_languages_pt03_doc", "target":