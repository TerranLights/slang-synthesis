{"nodes": [{"id": "established_071_longman_grammar_practice_pt06_document", "label": "Longman Grammar Practice Ch.6: Adjectives", "file_type": "document", "source_file": "established/071_longman_grammar_practice_pt06.md", "source_location": null, "source_url": null, "captured_at": null, "author": "L. G. Alexander", "contributor": null}, {"id": "established_071_longman_grammar_practice_pt06_adjective_suffixes", "label": "Adjective-forming suffixes (-able, -ful, -ic, -ive, -ant, -ish, -ly, -ous)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt06.md", "source_location": "p.80", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt06_negating_prefixes", "label": "Adjective-negating prefixes (un-, in-, il-, im-, dis-, ir-)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt06.md", "source_location": "p.80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Specific prefix is determined by following sound/spelling, largely unpredictable and must be learned per word; pre-/hyper- modify meaning without creating a true opposite."}, {"id": "established_071_longman_grammar_practice_pt06_compound_measurement_adj", "label": "Compound adjectives of measurement (number + singular noun + hyphen)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt06.md", "source_location": "p.81", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt06_position_meaning_shift", "label": "Adjectives whose meaning shifts with position (early, ill, late, sick...)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt06.md", "source_location": "p.82", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt06_either_side_adj", "label": "Adjectives with different meaning on either side of noun (concerned, present, elect...)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt06.md", "source_location": "p.83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt06_the_adjective_group_noun", "label": "'The' + adjective as group noun (the blind, the rich, the elderly...)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt06.md", "source_location": "p.84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closed set only; never usable singular/countable ('he is blind' / 'a blind man' instead) \u2014 the ordinary adjective+noun construction supplies the individual reading."}, {"id": "established_071_longman_grammar_practice_pt06_ed_ing_pairs", "label": "-ed/-ing adjective pairs: experiencer vs causer (amazed/amazing)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt06.md", "source_location": "p.85", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt06_linking_verb_adjective", "label": "Adjective (not adverb) after linking/sense verbs (look, feel, seem, smell, taste, sound)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt06.md", "source_location": "p.86", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt06_compound_noun_order", "label": "Word order in compound nouns and past-participle + compound noun", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt06.md", "source_location": "p.86", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt06_multi_adjective_order", "label": "Multi-adjective stacking order (opinion>size>age>shape>colour>origin>past participle>noun)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt06.md", "source_location": "p.87", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt06_comparison_regular", "label": "Regular comparative/superlative formation (-er/-est spelling rules)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt06.md", "source_location": "p.88", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt06_comparison_two_syllable", "label": "Two-syllable adjective comparison (-er/-est vs more/most)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt06.md", "source_location": "p.88", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt06_comparison_irregular", "label": "Irregular/often-confused comparatives (further/farther, elder/eldest, good/bad/much/little)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt06.md", "source_location": "p.89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "elder/eldest restricted to family relations and pre-noun position only, cannot follow be+than (use older instead); lesser is a defective comparative confined to fixed phrases."}, {"id": "established_071_longman_grammar_practice_pt06_vocab_the_blind", "label": "'the blind' / 'the rich' / 'the poor' \u2014 group-noun vocabulary example", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt06.md", "source_location": "p.84", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt06_vocab_fu