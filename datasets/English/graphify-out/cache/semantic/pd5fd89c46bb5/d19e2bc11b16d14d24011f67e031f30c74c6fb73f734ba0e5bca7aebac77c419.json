{"nodes": [{"id": "established_073_english_language_historical_intro_pt03_document", "label": "The English Language: A Historical Introduction \u2014 Ch.5 Old English", "file_type": "document", "source_file": "established/073_english_language_historical_intro_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Charles Barber, Joan C. Beal & Philip A. Shaw", "contributor": null}, {"id": "established_073_english_language_historical_intro_pt03_oe_dialects_west_saxon_anglian", "label": "OE dialects: West Saxon literary prestige vs. Anglian ancestry of Standard English", "file_type": "concept", "source_file": "established/073_english_language_historical_intro_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modern Standard English descends mainly from an Anglian (East Midland) dialect, not the dominant West Saxon literary standard (cf. wold/cold/hear all descending from Anglian forms)."}, {"id": "established_073_english_language_historical_intro_pt03_oe_writing_system_runes", "label": "OE writing system: futhorc runes to Latin alphabet with runic loans (wynn, thorn, eth)", "file_type": "concept", "source_file": "established/073_english_language_historical_intro_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_073_english_language_historical_intro_pt03_oe_phoneme_allophones", "label": "OE phoneme inventory and four context-conditioned allophone pairs (f/v, s/z, \u03b8/\u00f0, k/t\u0283)", "file_type": "concept", "source_file": "established/073_english_language_historical_intro_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_073_english_language_historical_intro_pt03_front_mutation_i_umlaut", "label": "Front mutation (i-umlaut), breaking, and back mutation", "file_type": "concept", "source_file": "established/073_english_language_historical_intro_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A vowel followed by i/j fronted/raised and the conditioning sound then disappeared, leaving a permanent synchronically-unmotivated vowel alternation (d\u0101l/d\u01e3lan, m\u016bs/m\u0233s, f\u014dd/f\u0113dan) \u2014 distinct in mechanism from the older PIE ablaut pattern (sing/sang)."}, {"id": "established_073_english_language_historical_intro_pt03_oe_nominal_morphology_case", "label": "OE nominal morphology: four-case system, declension collapse, -as plural ancestry", "file_type": "concept", "source_file": "established/073_english_language_historical_intro_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_073_english_language_historical_intro_pt03_oe_verbal_morphology_helpan", "label": "OE strong-verb paradigm (helpan) and periphrastic perfect/passive", "file_type": "concept", "source_file": "established/073_english_language_historical_intro_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only verbs taking an accusative object could be passivized in OE; dative-governing verbs like helpan could not form a passive until ME lost the dative/accusative distinction."}, {"id": "established_073_english_language_historical_intro_pt03_oe_word_order", "label": "OE word order: case-conditioned flexibility (SVO default, VSO/SOV triggers)", "file_type": "concept", "source_file": "established/073_english_language_historical_intro_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_073_english_language_historical_intro_pt03_oe_pronoun_case_syncretism", "label": "OE pronoun case syncretism (dative absorbs accusative: him, me, us, her)", "file_type": "concept", "source_file": "established/073_english_language_historical_intro_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modern English's 'accusative' pronoun forms are technically descended from OE datives (\u0113ow, hine->him path), not OE true accusatives, for every personal pronoun except it."}, {"id": "established_073_english_language_historical_intro_pt03_oe_poetic_register_alliteration", "label": "OE poetic register: alliterative meter, kennings, formulaic vocabulary", "file_type": "concept", "source_file": "established/073_english_language_historical_intro_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_073_english_language_historical_intro_pt03_oe_word_formation_compounding", "label": "OE word-formation: affixation and compounding", "file_type": "concept", "source_file": "established/073_english_language_historical_intro_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_073_english_language_historical_intro_pt03_wealh_etymology", "label": "wealh \u2014 foreigner/servant, ancestor of Welsh, Cornwall, walnut", "file_type": "concept", "source_file": "established/073_english_language_historical_intro_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_073_english_language_historical_intro_pt03_godspell_calque", "label": "g\u014ddspell \u2014 native calque of Latin evangelium", "file_type": "concept", "source_file": "established/073_english_language_historical_intro_pt03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "established_073_english_language_historical_intro_pt03_document", "target": "established_073_english_language_historical_intro_pt03_oe_dialects_wes