{"nodes": [{"id": "established_081_old_english_literature_short_intro_pt01_document", "label": "Old English Literature: A Short Introduction, Ch.1-2 (Donoghue 2004)", "file_type": "document", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Daniel Donoghue", "contributor": null}, {"id": "established_081_old_english_literature_short_intro_pt01_treow_homograph", "label": "treow as a true homograph ('tree' / 'troth'), not a coincidental pun", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The two senses share an Indo-European root meaning 'to be firm, solid, steadfast'; The Husband's Message exploits this deliberately, so the doubling is historically motivated, not merely wordplay."}, {"id": "established_081_old_english_literature_short_intro_pt01_dual_pronouns", "label": "Dual-number pronouns (wit, unc) marking reciprocal vows", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OE retains a grammatical dual (exactly two referents), used in The Wife's Lament precisely where a mutually exchanged pledge is described; the author argues the dual grammatically encodes reciprocity a plural would not."}, {"id": "established_081_old_english_literature_short_intro_pt01_grammatical_natural_gender", "label": "Grammatical vs. natural gender: monna and the risk of editorial over-reading", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "monna carries no inherent natural-gender reference, yet standard editions gloss it 'man', inducing readers to wrongly assume the referent is male \u2014 a translation-convention artifact independent of the OE itself."}, {"id": "established_081_old_english_literature_short_intro_pt01_formulaic_epithets", "label": "Lord-epithets clustering around generosity and personal affection", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "gold-wine, gold-gyfa, wine-dryhten are 'about as common as any other epithets for a lord', used to argue Anglo-Saxon society did not frame the lord-retainer bond as emotionally asymmetrical."}, {"id": "established_081_old_english_literature_short_intro_pt01_forthon_connective", "label": "for\u00feon as a logical connective applied to an avowedly non-logical impulse", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Seafarer uses 'therefore' to link a seabird's cry to the speaker's own irrational compulsion to return to sea \u2014 a causal particle used rhetorically rather than strictly propositionally."}, {"id": "established_081_old_english_literature_short_intro_pt01_beot", "label": "beot 'vow, promise, boast, vaunt' (contraction of be-hat)", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_081_old_english_literature_short_intro_pt01_gielp", "label": "gielp/gylp 'boast' (heroic-boast register in Beowulf and Maldon)", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_081_old_english_literature_short_intro_pt01_wine_treow", "label": "wine-treow 'vow of friendship' (The Husband's Message)", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_081_old_english_literature_short_intro_pt01_gold_wine", "label": "gold-wine 'gold-friend' (lord epithet)", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_081_old_english_literature_short_intro_pt01_wine_dryhten", "label": "wine-dryhten 'friend-lord' (lord epithet)", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_081_old_english_literature_short_intro_pt01_gold_gyfa", "label": "gold-gyfa 'gold-giver' (lord epithet)", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_081_old_english_literature_short_intro_pt01_wyrd", "label": "wyrd 'fate' (The Wanderer impersonal force vs. The Seafarer's God-synonymous use)", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_081_old_english_literature_short_intro_pt01_laene", "label": "l\u00e6ne 'on loan, transitory, impermanent' (Wanderer/Seafarer mortality vocabulary)", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_081_old_english_literature_short_intro_pt01_monna_gender", "label": "monna (variant of mann) unmarked for natural gender", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_081_old_english_literature_short_intro_pt01_uton_mention", "label": "uton we hycgan (forward-reference: hortatory auxiliary discussed at length in ch.4)", "file_type": "concept", "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "established_081_old_english_literature_short_intro_pt01_document", "target": "established_081_old_english_literature_short_intro_pt01_treow_homograph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "weight": 1.0}, {"source": "established_081_old_english_literature_short_intro_pt01_document", "target": "established_081_old_english_literature_short_intro_pt01_dual_pronouns", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "weight": 1.0}, {"source": "established_081_old_english_literature_short_intro_pt01_document", "target": "established_081_old_english_literature_short_intro_pt01_grammatical_natural_gender", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/081_old_english_literature_short_intro_pt01.md", "source_location": null, "weight": 1.0}, {"source": "established_081_old_en