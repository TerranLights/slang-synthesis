{"nodes": [{"id": "established_082_poetics_of_old_english_document", "label": "The Poetics of Old English (Beechy 2010, full book)", "file_type": "document", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Tiffany Beechy", "contributor": null}, {"id": "established_082_poetics_of_old_english_no_native_prose_term", "label": "No native OE term for 'prose' as a register opposed to 'poetry'", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Terms for important literary language (spell, leo\u00f0, cwide, fitt, gidda) overlap and co-occur rather than opposing; the functional register distinction in OE is 'patterned/important speech' vs. everyday unpatterned speech, not verse vs. prose."}, {"id": "established_082_poetics_of_old_english_word_pair_typology", "label": "Word-pair typology (after Calvert Watkins, applied to OE data)", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simple pairs (qualifiers, quantifiers) designate a single concept directly; complex pairs (kennings, merisms) index a third, higher concept; Wulfstan's un-prefixed lexical negation pairs form a third simple-pair type not in Watkins's original inventory."}, {"id": "established_082_poetics_of_old_english_legal_formula_structure", "label": "Legal formula structure \u2014 the balanced equation (Gif + CONDITION + COMPENSATION)", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u00c6thelberht's statute template enacts the legal principle of equivalence/compensation as grammar \u2014 the sentence offers no predicate to negate or contest, functioning as 'poetic shorthand' that forecloses argument."}, {"id": "established_082_poetics_of_old_english_figura_etymologica", "label": "Figura etymologica as a legal/poetic device", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pairing two words sharing an actual or perceived etymological root asserts an a priori, natural-seeming link between them, lending legal/theological assertions an air of inevitable truth rather than arbitrary stipulation."}, {"id": "established_082_poetics_of_old_english_slant_alliteration", "label": "Alliteration beyond identical onset \u2014 feature-based ('slant') alliteration", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pairs linked not by identical onsets but by shared phonetic features (voicing, place/manner of articulation) register poetic sound-patterning beneath the threshold of strict alliteration/rhyme, used to identify structuring in non-classically-scanning passages."}, {"id": "established_082_poetics_of_old_english_ring_composition_chiasmus", "label": "Ring composition and chiasmus", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A passage's opening term is echoed at its close, often with an internal repetition at a structural 'hub'; chiasmus is a diagonal x-shaped trading of parallel terms. Both are descriptive structural labels, not evidence of classical rhetorical training."}, {"id": "established_082_poetics_of_old_english_elegiac_formula", "label": "Formulaic elegiac phrase: HAVE/TAKE + to + dative + coordinated noun pair", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attested in both Blickling IX and 'Deor', the formula's repetition across genres supports reading it as a genuinely traditional, cross-text phrasal unit rather than a one-off coinage."}, {"id": "established_082_poetics_of_old_english_charm_language_opacity", "label": "Charm language tolerates \u2014 and depends on \u2014 semantic opacity", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A charm's efficacy depends on the form of its language (repetition, sound-density) rather than transparent referential sense, so nonsense syllables and untranslated Latin are expected charm-register features, and archaic forms persist disproportionately."}, {"id": "established_082_poetics_of_old_english_metrical_theory", "label": "Metrical theory: classical constraints vs. 'late Old English verse'", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bredehoft's late-OE-verse model and Hanson & Kiparsky's Parametric Theory both let \u00c6lfric's and Wulfstan's rhythmic homiletic prose be read as metrically regular verse, supporting the claim that the OE verse/prose boundary is far less sharp than conventional scholarship assumes."}, {"id": "established_082_poetics_of_old_english_register_stratification", "label": "Register stratification case study: folde vs. eor\u00f0e ('earth')", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "eor\u00f0e is the unmarked prose word for 'earth' while folde is the marked, poetic-register equivalent, attested 257 times almost entirely in verse/homily/glosses; the cognate Old Norse fold shows the same specialization, suggesting the split may be inherited."}, {"id": "established_082_poetics_of_old_english_interlace_refrain_deor", "label": "Interlace and refrain as distinct structuring devices in 'Deor'", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deor links its autobiographical strophe to legendary strophes via half-line correspondences ('interlace'); its refrain's grammatical ambiguity mirrors the poem's binding structure, while Wulf and Eadwacer's similarly placed refrain instead marks disjunction \u2014 refrain's function is text-specific, not inherent to the form."}, {"id": "established_082_poetics_of_old_english_earendel", "label": "earendel 'dawn, morning star' (rare marked term, likely folk-reanalyzed morphology)", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_082_poetics_of_old_english_hronrad_kenning", "label": "hronrad 'whale-road' (= the sea; compositional kenning)", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_082_poetics_of_old_english_folces_hyrde_kenning", "label": "folces hyrde 'shepherd of the people' (= king; genitival kenning)", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_082_poetics_of_old_english_word_and_weorc_merism", "label": "word and weorc 'words and deeds' (totalizing merism for all human activity)", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_082_poetics_of_old_english_riht_unriht_pair", "label": "riht/unriht 'right'/'unright' (lexical negation antonym pair)", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_082_poetics_of_old_english_fitt_term", "label": "fitt (Meters of Boethius preface's term for a section/canto of verse)", "file_type": "concept", "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "established_082_poetics_of_old_english_document", "target": "established_082_poetics_of_old_english_no_native_prose_term", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "weight": 1.0}, {"source": "established_082_poetics_of_old_english_document", "target": "established_082_poetics_of_old_english_word_pair_typology", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "weight": 1.0}, {"source": "established_082_poetics_of_old_english_document", "target": "established_082_poetics_of_old_english_legal_formula_structure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "weight": 1.0}, {"source": "established_082_poetics_of_old_english_document", "target": "establ