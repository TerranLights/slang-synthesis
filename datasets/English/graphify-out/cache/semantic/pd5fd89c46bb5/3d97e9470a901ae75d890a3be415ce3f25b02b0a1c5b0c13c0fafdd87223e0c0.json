_score": 1.0, "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "weight": 1.0}, {"source": "established_082_poetics_of_old_english_document", "target": "established_082_poetics_of_old_english_interlace_refrain_deor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "weight": 1.0}, {"source": "established_082_poetics_of_old_english_document", "target": "established_082_poetics_of_old_english_earendel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "weight": 1.0}, {"source": "established_082_poetics_of_old_english_document", "target": "established_082_poetics_of_old_english_fitt_term", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "weight": 1.0}, {"source": "established_082_poetics_of_old_english_word_pair_typology", "target": "established_082_poetics_of_old_english_hronrad_kenning", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "weight": 1.0}, {"source": "established_082_poetics_of_old_english_word_pair_typology", "target": "established_082_poetics_of_old_english_folces_hyrde_kenning", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/082_poetics_of_old_english.md", "source_location": null, "weight": 1.0}, {"source": "established_082_poetics_of_old_english_word_pair_typology", "target": "established_082_poetics_of_old_english_word_and_weorc_merism", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/082_poetics_of_old_english.md"