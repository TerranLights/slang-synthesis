": "concept", "source_file": "established/071_longman_grammar_practice_pt07.md", "source_location": "p.98", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt07_degree_much_far_lot", "label": "Degree adverbs much/far/a lot/any with comparatives", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt07.md", "source_location": "p.99", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt07_intensifiers_very_too", "label": "Intensifiers very/too/very much and fixed-collocation substitutes", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt07.md", "source_location": "pp.100-101", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt07_focus_adverbs", "label": "Focus adverbs even/only/just/simply shift sentence focus by position", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt07.md", "source_location": "p.102", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt07_addition_too_either_also", "label": "Addition adverbs too/either/also/as well", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt07.md", "source_location": "pp.102-103", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt07_viewpoint_connecting_adverbs", "label": "Viewpoint adverbs (certainty/brevity/opinion) and connecting adverbs (addition/contrast/summary)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt07.md", "source_location": "p.104", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt07_inversion_negative_adverbs", "label": "Negative-adverb fronting triggers subject-auxiliary inversion (never, hardly, rarely, seldom)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt07.md", "source_location": "p.105", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fronting a negative adverb or restrictive phrase (only after/then/when) at the start of a sentence forces question-style subject-auxiliary inversion; this register is distinctly formal/literary."}], "edges": [{"source": "established_071_longman_grammar_practice_pt07_document", "target": "established_071_longman_grammar_practice_pt07_manner_no_ly", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/071_longman_grammar_practice_pt07.md", "source_location": "p.90", "weight": 1.0}, {"source": "established_071_longman_grammar_practice_pt07_document", "target": "established_071_longman_grammar_practice_pt07_dual_form_adverbs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/071_longman_grammar_practice_pt07.md", "source_location": "p.90", "weight": 1.0}, {"source": "established_071_longman_grammar_practice_pt07_document", "target": "established_071_longman_grammar_practice_pt07_ly_adjectives_no_second_ly", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/071_longman_grammar_practice_pt07.md", "source_location": "p.91", "weight": 1.0}, {"source": "established_071_longman_grammar_practice_pt07_document", "target": "established_071_longman_grammar_practice_pt07_points_of_time", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/071_longman_grammar_practice_pt07.md", "source_location": "p.92", "weight": 1.0}, {"source": "established_071_longman_grammar_practice_pt07_document", "target": "established_0