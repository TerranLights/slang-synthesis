{"nodes": [{"id": "established_071_longman_grammar_practice_pt11_document", "label": "Longman Grammar Practice Ch.11 Pt.1: Modal Auxiliaries and Related Verbs", "file_type": "document", "source_file": "established/071_longman_grammar_practice_pt11.md", "source_location": null, "source_url": null, "captured_at": null, "author": "L. G. Alexander", "contributor": null}, {"id": "established_071_longman_grammar_practice_pt11_modal_list", "label": "Ten modal auxiliaries plus three semi-modals (need, dare, used to)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt11.md", "source_location": "p.156", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt11_first_use_basic_meaning", "label": "First use of modals: basic dictionary meaning (ability, permission, prediction, duty, obligation)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt11.md", "source_location": "p.156", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt11_missing_parts_have_to_be_able", "label": "Modals as incomplete verbs: 'have to'/'be able to' supply missing tense forms", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt11.md", "source_location": "p.156", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modals can't be to-infinitives ('*to can*'), can't follow another modal, and take no 3rd-person -(e)s; 'have to' supplies must's past, 'be able to' supplies can's future and other missing forms."}, {"id": "established_071_longman_grammar_practice_pt11_second_use_certainty", "label": "Second use of modals: certainty/possibility scale (might<could/would<must/can't)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt11.md", "source_location": "p.157", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt11_ability_can_be_able_managed", "label": "Ability/inability: can/be able to vs managed to for one completed specific action", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt11.md", "source_location": "p.158", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt11_perception_can_could", "label": "'Can/could' + perception verbs substituting for simple present/past", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt11.md", "source_location": "p.158", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt11_can_could_habitual", "label": "'Can be'/'could be' substituting for 'is often'/'was often'", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt11.md", "source_location": "p.159", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt11_permission_politeness_gradient", "label": "Politeness gradient for permission requests: can<could<may<might", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt11.md", "source_location": "p.160", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt11_permission_granting_authority", "label": "Personal authority (can/may) vs external authority (be allowed/permitted/forbidden to) for permission/prohibition", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt11.md", "source_location": "pp.160-161", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt11_certainty_possibility_be", "label": "Certainty (be/full verb) vs possibility (may/might/could + be/have been)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt11.md", "source_location": "p.162", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt11_do_done_substitution", "label": "'Do'/'done' substituting for a repeated full verb in a modal answer", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt11.md", "source_location": "p.163", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt11_deduction_must_cant", "label": "Deduction: 'must be'/'can't be' (present) and 'must have been'/'can't have been' (past)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt11.md", "source_location": "pp.164-165", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt11_mustnt_vs_cant_trap", "label": "'Mustn't be' (prohibition) vs 'can't be' (negative deduction) contrast trap", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt11.md", "source_location": "p.164", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deduction's negative is always 'can't be', never 'mustn't be'; 'mustn't (be)' instead negates 'must (be)' = total obligation (prohibition). Same surface form 'must be' carries two senses distinguished only by context."}, {"id": "established_071_longman_grammar_practice_pt11_offers_requests_suggestions", "label": "Six parallel offer/request/suggestion constructions (would you like, can I have, shall I/we)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt11.md", "source_location": "pp.166-167", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edge