{"nodes": [{"id": "established_040_cmos_ch11_foreign_languages_pt05_cmos_source", "label": "CMOS Ch.11 Foreign Languages pt05", "file_type": "document", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": "University of Chicago Press Staff", "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_proofreading_non_latin_alphabets_caution", "label": "Caution: proofread non-Latin scripts carefully; cite Unicode number/description when in doubt (11.93)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_diacritics_specialized_vs_general_rule", "label": "Use as few diacritics as needed for nonspecialized works, favoring Merriam-Webster forms (11.94)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_italics_vs_roman_transliterated_terms_rule", "label": "Transliterated non-proper-name terms italicized until absorbed into English (agap\u0113/agape) (11.95)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_arabic_transliteration_systems_concept", "label": "No universally accepted Arabic transliteration system; pick one and minimize exceptions (11.96)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_hamza_ayn_marks_concept", "label": "Hamza and \u02bfayn marks must stay visually distinct; risky informal apostrophe/quote substitutions (11.97)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_arabic_well_known_names_spelling_rule", "label": "Well-known Arabic names/places use the familiar English form, not strict transliteration (11.98)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_arabic_definite_article_rule", "label": "Arabic definite article al- hyphenated to its noun; l-assimilation sometimes shown (11.99)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_arabic_word_division_rule", "label": "Arabic word-division restrictions: never split dh/gh/kh/sh/th unless both underdotted (11.101)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_chinese_pinyin_romanization_system", "label": "Hanyu Pinyin has supplanted Wade-Giles and the Postal Atlas as the standard Chinese romanization (11.102)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_pinyin_exceptions_rule", "label": "Certain long-familiar proper nouns may keep their old-form spelling despite Pinyin standard (11.103)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_chinese_romanization_apostrophe_tone_marks_rule", "label": "Pinyin apostrophe use to prevent syllable-merging ambiguity (Xi'an vs Xian); LC system omits tone marks (11.104)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_japanese_romanization_hepburn_system", "label": "Modified Hepburn system (hy\u014djun), macron long-vowel marking with place-name exceptions (11.106-11.107)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_chinese_japanese_capitalization_italics_rule", "label": "Capitalization/italics for romanized Chinese/Japanese; institution names roman vs. italic common nouns (11.108)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_hebrew_transliteration_systems_concept", "label": "Several acceptable Hebrew romanization systems; author must apply one consistently (11.111)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_hebrew_diacritics_concept", "label": "Hebrew transliteration diacritics: underdots, macrons, acute, ha\u010deks, superscript schwa (11.112)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_hebrew_unromanized_phrase_direction_rule", "label": "Unromanized Hebrew phrases embedded in English preserve right-to-left internal word order (11.116)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_040_cmos_ch11_foreign_languages_pt05_mojibake_utf8_as_latin1_cipher", "label": "UTF-8-as-Latin-1 mojibake cipher (this file: \u02bfayn/hamza modifier letters, Y\u00fcan, r\u014dmaji macron-o)", "file_type": "concept", "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-uniform even within single pages: the same sidebar heading phrase renders cleanly on one page and corrupted on the very next, confirming this is not a blanket cipher but a per-instance artifact."}], "edges": [{"source": "established_040_cmos_ch11_foreign_languages_pt05_proofreading_non_latin_alphabets_caution", "target": "established_040_cmos_ch11_foreign_languages_pt05_cmos_source", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/040_cmos_ch11_foreign_languages_pt05.md", "source_location": null, "weight": 1.0}, {"source": "established_040_cmos_ch11_foreign_languages_pt05_diacritics_specialized_vs_general_rule", "target": "established_040_cmos_ch1