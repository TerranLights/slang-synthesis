{"nodes": [{"id": "established_088_grammar_of_english_grammars_pt08_document", "label": "Grammar of English Grammars pt08 (Syntax Rules XVIII-XXIV, General Rule)", "file_type": "document", "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null}, {"id": "established_088_grammar_of_english_grammars_pt08_rule18_infinitive_to", "label": "Rule XVIII: infinitive governed by preposition TO", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null}, {"id": "established_088_grammar_of_english_grammars_pt08_rule19_bare_infinitive", "label": "Rule XIX: bare-infinitive-taking verb class (bid, dare, feel, hear, let, make, need, see)", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null}, {"id": "established_088_grammar_of_english_grammars_pt08_rule20_participles", "label": "Rule XX: participles relate to nouns/pronouns or are governed by prepositions", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null}, {"id": "established_088_grammar_of_english_grammars_pt08_rule20_gerund_of_insertion", "label": "gerund-vs-participle 'of'-insertion problem", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null, "rationale": "A fully nominalized transitive participle must take 'of' before its object ('the receiving of Christ'); a true participle must not ('keeping of one day' flagged wrong). Also warns against confusing perfect participles with preterits ('it was wrote' for 'it was written')."}, {"id": "established_088_grammar_of_english_grammars_pt08_rule21_adverbs", "label": "Rule XXI: adverbs relate to verbs, participles, adjectives, or other adverbs", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null}, {"id": "established_088_grammar_of_english_grammars_pt08_rule21_double_negation", "label": "Note VIII: single-negation rule (no double negatives)", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null, "rationale": "Canonical 19th-century prescriptive statement that two negatives make an affirmative; directly relevant to this project because double/multiple negation is standard and grammatical in many dialects and slang registers, marking the prescriptive/vernacular fault line."}, {"id": "established_088_grammar_of_english_grammars_pt08_rule22_conjunctions", "label": "Rule XXII: conjunctions connect words, sentences, or parts of sentences", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null}, {"id": "established_088_grammar_of_english_grammars_pt08_rule22_correlative_pairs", "label": "14-item table of correspondent-conjunction pairs (though...yet, either...or, etc.)", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null}, {"id": "established_088_grammar_of_english_grammars_pt08_rule23_prepositions", "label": "Rule XXIII: prepositions show relations of words/things/thoughts", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null}, {"id": "established_088_grammar_of_english_grammars_pt08_rule24_interjections", "label": "Rule XXIV: interjections have no dependent construction, put absolute", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null, "rationale": "Brown refutes the contemporary claim that interjections 'govern' a case (e.g. 'Oh me!' vs 'O thou persecutor!'), arguing the noun/pronoun is in the nominative absolute or governed by an implied preposition instead."}, {"id": "established_088_grammar_of_english_grammars_pt08_general_rule_of_syntax", "label": "General Rule of Syntax and its 16 Critical Notes (Ch. XIII capstone)", "file_type": "concept", "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Goold Brown", "contributor": null, "rationale": "A deliberately broad capstone rule ('consistency and adaptation of all the words should be carefully observed') functioning as general principles of clear composition and logical argument rather than a specific grammar rule: parts of speech, doubtful reference, definitions, comparisons, falsities, absurdities, self-contradiction, senseless jumbling, needless words, improper omissions, literary blunders, perversions, awkwardness, ignorance, silliness, the incorrigible."}], "edges": [{"source": "established_088_grammar_of_english_grammars_pt08_document", "target": "established_088_grammar_of_english_grammars_pt08_rule18_infinitive_to", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "weight": 1.0}, {"source": "established_088_grammar_of_english_grammars_pt08_document", "target": "established_088_grammar_of_english_grammars_pt08_rule19_bare_infinitive", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "weight": 1.0}, {"source": "established_088_grammar_of_english_grammars_pt08_document", "target": "established_088_grammar_of_english_grammars_pt08_rule20_participles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "weight": 1.0}, {"source": "established_088_grammar_of_english_grammars_pt08_document", "target": "established_088_grammar_of_english_grammars_pt08_rule21_adverbs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "weight": 1.0}, {"source": "established_088_grammar_of_english_grammars_pt08_document", "target": "established_088_grammar_of_english_grammars_pt08_rule22_conjunctions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "weight": 1.0}, {"source": "established_088_grammar_of_english_grammars_pt08_document", "target": "established_088_grammar_of_english_grammars_pt08_rule23_prepositions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/088_grammar_of_english_grammars_pt08.md", "source_location": null, "weight": 1.0}, {"source": "established_088_grammar_of_english_grammars_pt08_document", "target": "established_088_grammar_of_english_grammars_pt08_rule24_interjections", "relation": "references", "confidence": "EXTRACTED", "confidence_sco