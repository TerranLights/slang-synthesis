{"nodes": [{"id": "established_071_longman_grammar_practice_pt08_document", "label": "Longman Grammar Practice Ch.8: Prepositions, Adverb Particles, Phrasal Verbs", "file_type": "document", "source_file": "established/071_longman_grammar_practice_pt08.md", "source_location": null, "source_url": null, "captured_at": null, "author": "L. G. Alexander", "contributor": null}, {"id": "established_071_longman_grammar_practice_pt08_prep_particle_dual", "label": "Dual-use words: preposition (with object) or adverb particle (no object)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt08.md", "source_location": "p.106", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt08_prep_only", "label": "Words restricted to preposition-only use (against, among, at, beside...)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt08.md", "source_location": "p.106", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt08_particle_only", "label": "Words restricted to adverb-particle-only use (away, back, out, upward(s)...)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt08.md", "source_location": "p.106", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt08_prep_conjunction_dual", "label": "Dual-use words: preposition (+ object) or conjunction (+ clause) (after, as, before, since, till/until)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt08.md", "source_location": "p.107", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt08_object_pronoun_after_prep", "label": "Object pronoun form required after any preposition ('between you and me')", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt08.md", "source_location": "p.107", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt08_movement_position_preps", "label": "Prepositions of movement and static position (to/from/into/out of/at/in/on)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt08.md", "source_location": "p.108", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt08_time_preps", "label": "Prepositions of time: at (exact)/on (days/dates)/in (periods)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt08.md", "source_location": "p.109", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt08_contrast_sets", "label": "Confused preposition/particle contrast sets (8.3-8.5: about/on, beside/besides, of/off...)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt08.md", "source_location": "pp.110-115", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt08_phrasal_taxonomy", "label": "Four-type phrasal-verb taxonomy (Type1-4: preposition/particle, transitive/intransitive)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt08.md", "source_location": "p.116", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_071_longman_grammar_practice_pt08_type1_nonidiomatic", "label": "Type 1 non-idiomatic: verb + fixed preposition, literal (agree with, suffer from)", "file_type": "concept", "source_file": "established/071_longman_grammar_practice_pt08.md", "source_location": "p.116", "source_url": null, "captured_at": null, "author": null, "contr