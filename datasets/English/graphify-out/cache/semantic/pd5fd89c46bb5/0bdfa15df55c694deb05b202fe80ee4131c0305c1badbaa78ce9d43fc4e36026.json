{"nodes": [{"id": "established_080_critical_companion_beowulf_pt02_document", "label": "A Critical Companion to Beowulf, Ch.3 \"Style and Structure\" (Orchard 2003)", "file_type": "document", "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Andy Orchard", "contributor": null}, {"id": "established_080_critical_companion_beowulf_pt02_repetition_variation", "label": "Repetition and variation as governing stylistic principles (appositive style)", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orchard treats repetition (echo) and variation (restating a referent in different terms) as a single duality operating at every level from sound to theme, per Fred Robinson's term 'appositive style'."}, {"id": "established_080_critical_companion_beowulf_pt02_compounding", "label": "Compounding as the primary engine of poetic vocabulary expansion", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five 'war'/'battle' roots generate 103 distinct compounds with 78 final elements, 75 unattested elsewhere in OE; a quantified model of compounding as the dominant word-formation strategy for an elevated register."}, {"id": "established_080_critical_companion_beowulf_pt02_formulaic_substitution", "label": "Formulaic phrase-substitution systems", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Element-reversal, synonym-substitution-in-a-fixed-frame, cross-part-of-speech substitution, and interlocking formulas generate metrically-equivalent alliterative variants of the same statement; touches ~40% of lines but <1% is verbatim repetition."}, {"id": "established_080_critical_companion_beowulf_pt02_alliterative_patterning", "label": "Alliterative patterning: structural vs ornamental devices", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beyond the baseline b-line/a-line alliteration requirement, the poet layers double alliteration, cross-alliteration, interlinear alliteration, assonance, end-rhyme, and paronomasia for emphasis at structurally important moments."}, {"id": "established_080_critical_companion_beowulf_pt02_envelope_pattern", "label": "Envelope-pattern (ring-composition) and incremental repetition", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A passage opens and closes with the same/related sound-word-phrase bracketing a unit; incremental repetition recurs at the start of successive units to build momentum. The whole poem's beginning/ending-with-a-funeral is itself a largest-scale envelope."}, {"id": "established_080_critical_companion_beowulf_pt02_fitt_division", "label": "The fitt-division as a manuscript-native structural unit", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "43 numbered manuscript sections marked by Roman numerals/capitalization/blank lines, lengths 36-142 lines, formulaic openings in several; a discourse unit that does not map onto syntactic sentences or narrative scenes."}, {"id": "established_080_critical_companion_beowulf_pt02_kenning", "label": "Kenning (metaphorical compound substituted for an ordinary noun)", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Term borrowed from Old Norse-Icelandic poetics; OE beadoleoma/hildeleoma parallels Norse gunnlogi, suggesting inherited common Germanic poetic stock rather than independent coinage."}, {"id": "established_080_critical_companion_beowulf_pt02_hapax_legomenon", "label": "Hapax legomenon (critical terminology)", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scholarly usage varies between 'unique in the whole surviving corpus' and 'unique within a single poem'; different editors of the same text apply the term differently."}, {"id": "established_080_critical_companion_beowulf_pt02_hildeleoma", "label": "hildeleoma / beadoleoma 'battle-light' (sword kenning, reused of dragon-fire)", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_080_critical_companion_beowulf_pt02_guthwine", "label": "gu\u00f0wine 'war-friend' (deliberately ambiguous sword/companion kenning)", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_080_critical_companion_beowulf_pt02_secg_polyseme", "label": "secg 'man'/'sword' (deliberate polyseme pun)", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_080_critical_companion_beowulf_pt02_holtwudu_tautology", "label": "holtwudu 'wood-wood' (tautologous compound, two disambiguating meanings)", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_080_critical_companion_beowulf_pt02_sword_synonym_set", "label": "Six simplex sword-synonyms (bil, brond, ecg, heoru, mece, sweord) plus compound sword-kennings", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "established_080_critical_companion_beowulf_pt02_men_synonym_set", "label": "Six-to-eight synonym set for '(sea-)men' in the voyage passage (lines 210-28)", "file_type": "concept", "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "established_080_critical_companion_beowulf_pt02_document", "target": "established_080_critical_companion_beowulf_pt02_repetition_variation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "weight": 1.0}, {"source": "established_080_critical_companion_beowulf_pt02_document", "target": "established_080_critical_companion_beowulf_pt02_compounding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/080_critical_companion_beowulf_pt02.md", "source_location": null, "weight": 1.0}, {"source": "established_080_critical_companion_beowulf_pt02_document", "target": "established_080_critical_companion_beowulf_pt02_formulaic_substitution", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "