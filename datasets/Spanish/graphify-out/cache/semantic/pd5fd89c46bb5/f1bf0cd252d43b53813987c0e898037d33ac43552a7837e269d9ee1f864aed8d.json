34)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_spanish_established_113_taxi_a_coyoacan_nivel3_padre_misunderstanding", "label": "padre (Mexican colloquial \"awesome\") comic misunderstanding", "file_type": "concept", "source_file": "established/113_taxi_a_coyoacan_nivel3.md", "source_location": "note (27)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "the Spanish protagonist doesn't understand this Mexican-specific adjectival use of 'padre' (normally just 'father'); the misunderstanding is played for comic unease right before the robbery"}, {"id": "datasets_spanish_established_113_taxi_a_coyoacan_nivel3_coyoacan_setting", "label": "Coyoac\u00e1n / Museo Frida Kahlo (setting)", "file_type": "concept", "source_file": "established/113_taxi_a_coyoacan_nivel3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "datasets_spanish_established_113_taxi_a_coyoacan_nivel3", "target": "datasets_spanish_established_113_taxi_a_coyoacan_nivel3_mex_pen_glossary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/113_taxi_a_coyoacan_nivel3.md", "source_location": null, "weight": 1.0}, {"source": "datasets_spanish_established_113_taxi_a_coyoacan_nivel3", "target": "datasets_spanish_established_113_taxi_a_coyoacan_nivel3_camion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/113_taxi_a_coyoacan_nivel3.md", "source_location": null, "weight": 1.0}, {"source": "datasets_spanish_established_113_taxi_a_coyoacan_nivel3", "target": "datasets_spanish_established_113_taxi_a_coyoacan_nivel3_gachupin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/113_taxi_a_coyoacan_nivel3.md", "source_location": null, "weight": 1.0}, {"source": "datasets_spani