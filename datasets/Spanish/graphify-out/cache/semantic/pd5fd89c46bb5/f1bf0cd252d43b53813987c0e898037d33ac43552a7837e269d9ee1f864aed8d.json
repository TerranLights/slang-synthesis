{"nodes": [{"id": "datasets_spanish_established_113_taxi_a_coyoacan_nivel3", "label": "Taxi a Coyoac\u00e1n (Venga a leer, Nivel 3, Serie Am\u00e9rica Latina)", "file_type": "document", "source_file": "established/113_taxi_a_coyoacan_nivel3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_spanish_established_113_taxi_a_coyoacan_nivel3_mex_pen_glossary", "label": "Mexican-vs-Peninsular contrastive endnote glossary", "file_type": "concept", "source_file": "established/113_taxi_a_coyoacan_nivel3.md", "source_location": "pp.38\u201342, notes 1\u201349", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "because this is the 'Serie Am\u00e9rica Latina' entry and the protagonist is a Spaniard newly arrived in Mexico, nearly every endnote is deliberately phrased as an explicit Spain-vs-Mexico contrast ('in Spain this is called X'), making the glossary function as a structured dialect dictionary rather than a plain vocabulary list"}, {"id": "datasets_spanish_established_113_taxi_a_coyoacan_nivel3_camion", "label": "cami\u00f3n (false friend: truck in Spain, bus in Mexico)", "file_type": "concept", "source_file": "established/113_taxi_a_coyoacan_nivel3.md", "source_location": "note (4)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_spanish_established_113_taxi_a_coyoacan_nivel3_gachupin", "label": "gachup\u00edn (derogatory term for Spaniards)", "file_type": "concept", "source_file": "established/113_taxi_a_coyoacan_nivel3.md", "source_location": "note (32)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "explicitly marked 'despectivo' (derogatory) in the book's own gloss; used mockingly of the Spanish protagonist by his robbers"}, {"id": "datasets_spanish_established_113_taxi_a_coyoacan_nivel3_malinche", "label": "Malinche (historical/cultural figure)", "file_type"