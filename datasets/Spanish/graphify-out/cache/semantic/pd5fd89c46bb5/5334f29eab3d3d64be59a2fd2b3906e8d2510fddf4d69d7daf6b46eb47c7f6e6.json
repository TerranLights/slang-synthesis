{"nodes": [{"id": "081_using_spanish_synonyms_book", "label": "Using Spanish Synonyms (Batchelor, 2nd ed.)", "file_type": "document", "source_file": "established/081_using_spanish_synonyms.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "081_register_tagging_system_r3_r2_r1_r1star", "label": "R3/R2/R1/R1* Register Tagging System", "file_type": "concept", "source_file": "established/081_using_spanish_synonyms.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R3=formal, R2=neutral, R1=colloquial, R1*=vulgar/taboo, with A=Argentinian/M=Mexican regional tags; maps directly onto this project's own Usage-Tier taxonomy (formal/core/colloquial/taboo)"}, {"id": "081_abogado_lawyer_frame_animal_slurs", "label": "Abogado (Lawyer) Frame \u2014 Animal-Metaphor Slurs", "file_type": "concept", "source_file": "established/081_using_spanish_synonyms.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cuervo ('crow') and tordo ('thrush') as Argentine pejoratives for lawyer, alongside picapleitos ('ambulance chaser')"}, {"id": "081_bajo_vile_register_ladder", "label": "Bajo (Low/Vile) Register Ladder", "file_type": "concept", "source_file": "established/081_using_spanish_synonyms.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full register spread vil/abyecto/ruin (R3) down through pinche (Mexico, R1) to de la chingada (Mexico, R1*)"}, {"id": "081_chingada_productive_taboo_root", "label": "Chingada \u2014 Productive Mexican Taboo Root", "file_type": "concept", "source_file": "established/081_using_spanish_synonyms.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same chingada root recurs across unrelated semantic frames (vileness in bajo, difficulty in dificil) in this file alone"}, {"id": "081_pedo_productive_taboo_root", "label": "Pedo \u2014 Cross-Regionally Productive Taboo Metaphor Source", "file_type": "concept", "source_file": "established/081_using_spanish_synonyms.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pedo ('fart') productive in two regions with two different idiomatic extensions: de puro pedo = 'by sheer luck' (Argentina, casual frame), pedo = 'real difficulty/hassle' (Mexico, dificultad frame)"}, {"id": "081_concha_taboo_bay_frame", "label": "Concha \u2014 Vulgar for 'Bay' in Argentina (Golfo Frame)", "file_type": "concept", "source_file": "established/081_using_spanish_synonyms.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Register R2 generally, but book explicitly flags Argentina's avoidance due to vulgar anatomical sense \u2014 independently confirms the identical concha taboo flagged in 079 for 'snail'"}, {"id": "081_golpe_blow_punch_regional_frame", "label": "Golpe (Blow/Punch) Regional Synonym Frame", "file_type": "concept", "source_file": "established/081_using_spanish_synonyms.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "trompada, pi\u00f1a (fruit-metaphor 'pineapple' for punch), cachetada, porrazo \u2014 all Argentina/Mexico tagged; porrazo example cross-references poli clipped slang for cop"}, {"id": "081_water_toilet_euphemism_ladder", "label": "W\u00e1ter (Toilet) Euphemism Register Ladder", "file_type": "concept", "source_file": "established/081_using_spanish_synonyms.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full ladder from formal servicios/ba\u00f1o/aseos through the English loanword w\u00e1ter (R1, vulgar despite being a plain loan) down to cagadero/meadero (R1*); includes diachronic register-aging (excusado, retrete) differing by dialect"}, {"id": "081_el_sr_roca_brand_euphemism", "label": "El Sr Roca \u2014 Brand-Name Humor Euphemism", "file_type": "concept", "source_file": "established/081_using_spanish_synonyms.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Humorous euphemism for 'the bathroom' built on the ubiquitous Spanish plumbing-fixture brand Roca ('voy a visitar al Sr Roca') \u2014 a humor-driven euphemism-formation mechanism not seen elsewhere in this corpus"}, {"id": "081_blanket_regional_triplet_manta_cobija_frazada", "label": "Manta/Cobija/Frazada \u2014 Three-Way Regional Blanket Doublet", "file_type": "concept", "source_file": "established/081_using_spanish_synonyms.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "081_sampling_methodology_register_mapping", "label": "Complete-Semantic-Frame Sampling for Register Mapping", "file_type": "rationale", "source_file": "established/081_using_spanish_synonyms.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "22 complete semantic frames sampled (not partial frames) since the register contrast within a frame, not any single word, is the valuable unit; frames chosen for widest register spread and regional/taboo markers"}], "edges": [{"source": "081_using_spanish_synonyms_book", "target": "081_register_tagging_system_r3_r2_r1_r1star", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/081_using_spanish_synonyms.md", "source_location": null, "weight": 1.0}, {"source": "081_using_spanish_synonyms_book", "target": "081_abogado_lawyer_frame_animal_slurs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/081_using_spanish_synonyms.md", "source_loc