{"nodes": [{"id": "082_using_spanish_vocabulary_book", "label": "Using Spanish Vocabulary (Batchelor & San Jos\u00e9)", "file_type": "document", "source_file": "established/082_using_spanish_vocabulary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "082_concha_taboo_sexual_organs", "label": "Concha \u2014 Vulgar for Female Genitalia (\u00d3rganos Sexuales)", "file_type": "concept", "source_file": "established/082_using_spanish_vocabulary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Register R1*, tagged Argentina. Third independent corpus confirmation of concha's Argentine taboo status, after 079's 'avoid for snail' tip and 081's 'vulgar for bay' frame note"}, {"id": "082_hacer_el_amor_lovemaking_verb_ladder", "label": "Hacer el Amor \u2014 Full Formal-to-Vulgar Lovemaking Verb Ladder", "file_type": "concept", "source_file": "established/082_using_spanish_vocabulary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "c\u00f3pula/coito (R3, clinical) through hacer el amor (R2, neutral) down to chingar/coger(se)/follar/joder (R1*, taboo), each regionally distinct"}, {"id": "082_chingar_productive_taboo_root", "label": "Chingar \u2014 Primary Sexual Sense of Mexico's Most Productive Taboo Root", "file_type": "concept", "source_file": "established/082_using_spanish_vocabulary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Register R1*, tagged Mexico; explicitly cited by this file as cf. de la chingada sampled in 081"}, {"id": "082_coger_register_split_argentina_mexico_spain", "label": "Coger \u2014 Sexual Taboo Sense in Argentina/Mexico vs. Neutral in Spain", "file_type": "concept", "source_file": "established/082_using_spanish_vocabulary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source's own parenthetical ('has different meaning in Spain') independently confirms the Spain-vs-Argentina coger split already flagged in 079's Must-Know Tip, extending the vulgar sense to Mexico as well"}, {"id": "082_youth_slang_friend_terms", "label": "Regional Youth-Slang Terms for Friend/Kid/Guy", "file_type": "concept", "source_file": "established/082_using_spanish_vocabulary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cuate/chamaco/chava/compadre/compinche (Mexico) vs. chaval (general Spanish) vs. colega; cuate flagged as of N\u00e1huatl origin"}, {"id": "082_cuidados_corporales_toilet_euphemism_ladder", "label": "Cuidados Corporales \u2014 Personal-Hygiene/Toilet Euphemism Ladder", "file_type": "concept", "source_file": "established/082_using_spanish_vocabulary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "defecar (R3) through hacer caca/pip\u00ed (child's-language register, a new register category for this corpus) down to mear/cagar (R1*); explicitly cross-referenced to 081's meadero/cagadero nouns built on these same roots"}, {"id": "082_cantinflear_eponym_coinage", "label": "Cantinflear \u2014 Eponym Coinage from Comedian Cantinflas", "file_type": "concept", "source_file": "established/082_using_spanish_vocabulary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'To talk nonsense/without saying anything,' derived from Mexican film comedian Cantinflas famous for rambling, meaning-evasive dialogue \u2014 a named-individual eponym coinage mechanism distinct from borrowing/metaphor_productivity, flagged as a possible new derivation category"}, {"id": "082_polla_false_friend_homonym", "label": "Polla \u2014 Taboo/Innocuous Homonym Collision", "file_type": "concept", "source_file": "established/082_using_spanish_vocabulary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "polla = 'prick/dick' (R1*) but also the entirely innocuous standard word for 'lottery ticket/pool' in some dialects and 'female chick' in others \u2014 a genuine homonym-collision risk for learners"}, {"id": "082_usage_tier_per_sense_principle", "label": "Usage Tier Must Be Tracked Per-Sense, Not Per-Lemma", "file_type": "concept", "source_file": "established/082_using_spanish_vocabulary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "coger in fraganti ('to catch red-handed') sits at R3 while coger's sexual sense is R1*/taboo specifically in Argentina/Mexico \u2014 a single verb spanning the full register range depending purely on sense"}, {"id": "082_fruit_metaphor_body_parts_melones", "label": "Melones \u2014 Fruit-Based Body-Part Metaphor", "file_type": "concept", "source_file": "established/082_using_spanish_vocabulary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Tits (lit. melons)', explicitly cross-referenced in-source as cf. pi\u00f1a 'punch' in 081 \u2014 same productive fruit-metaphor source across unrelated semantic domains"}], "edges": [{"source": "082_using_spanish_vocabulary_book", "target": "082_concha_taboo_sexual_organs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/082_using_spanish_vocabulary.md", "source_location": null, "weight": 1.0}, {"source": "082_using_spanish_vocabulary_book", "target": "082_hacer_el_amor_lovemaking_verb_ladder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/082_using_spanish_vocabulary.md", "source_location": null, "weight": 1.0}, {"source": "082_hacer_el_amor_lovemaking_verb