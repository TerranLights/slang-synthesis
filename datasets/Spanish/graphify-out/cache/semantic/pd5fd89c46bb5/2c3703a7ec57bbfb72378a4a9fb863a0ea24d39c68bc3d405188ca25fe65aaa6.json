{"nodes": [{"id": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_book", "label": "Vocabulario Activo 2 (Intermedio-Avanzado)", "file_type": "document", "source_file": "established/085_vocabulario_activo_2_intermedio_avanzado.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Francisca C\u00e1rdenas Bernal", "contributor": null, "rationale": "Coverage focuses on unit types with no counterpart in companion volume 084 (Refranes, Expresiones equivalentes/coloquiales, Parecidos pero diferentes, Reacciones, Busca la palabra, \u00bfSer o estar?), since those are this source's clear non-redundant contribution; topically-identical units (Animales, La televisi\u00f3n, El coche, La familia) were sampled only to document depth/register escalation versus 084, per the non-redundant-supplement convention."}, {"id": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_refranes_proverbs", "label": "Refranes: 14 Traditional Spanish Proverbs", "file_type": "concept", "source_file": "established/085_vocabulario_activo_2_intermedio_avanzado.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_reacciones_fixed_phrases", "label": "Reacciones: Fixed Social Reaction-Formula Phrases", "file_type": "concept", "source_file": "established/085_vocabulario_activo_2_intermedio_avanzado.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_expresiones_equivalentes", "label": "Expresiones Equivalentes: Register/Paraphrase Equivalence Set", "file_type": "concept", "source_file": "established/085_vocabulario_activo_2_intermedio_avanzado.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_parecidos_pero_diferentes_gender_meaning", "label": "Parecidos Pero Diferentes: Gender-Determines-Meaning Minimal Pairs", "file_type": "concept", "source_file": "established/085_vocabulario_activo_2_intermedio_avanzado.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flagship structural finding: eleven pairs (el mango/la manga, el cometa/la cometa, etc.) where grammatical gender alone, not a different root or natural sex, distinguishes two genuinely different referents sharing the same base form \u2014 directly portable to a conlang noun-class system as 'same root, different noun-class = different but related meaning'."}, {"id": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_ser_estar_meaning_shift", "label": "\u00bfCon \"ser\" o \"estar\"?: Copula-Gated Lexical Meaning Shift", "file_type": "concept", "source_file": "established/085_vocabulario_activo_2_intermedio_avanzado.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flagship structural finding: six adjectives (atento, verde, abierto, listo, rico, malo) each carry a completely different meaning depending on whether paired with ser (inherent/characteristic) or estar (temporary state) \u2014 the clearest systematic case in this corpus of the ser/estar distinction working as a lexical meaning-disambiguator rather than just aspectual nuance; portable to a conlang copula/aspect system."}, {"id": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_antiguamente_hoy_en_dia_tech_pairs", "label": "Antiguamente... Hoy en D\u00eda: Obsolete-vs-Modern Technology Vocabulary Pairs", "file_type": "concept", "source_file": "established/085_vocabulario_activo_2_intermedio_avanzado.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_expresiones_coloquiales", "label": "Expresiones Coloquiales: Contemporary Peninsular Slang Set", "file_type": "concept", "source_file": "established/085_vocabulario_activo_2_intermedio_avanzado.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single most direct slang/colloquialism content in this source (majo, cabrearse, borde, rollo, irse de marcha, chupito, chulo, harta, traer sin cuidado), Spain-leaning rather than flagged pan-Hispanic; chulo is explicitly noted as register-dependent polysemous (positive 'cool' vs. pejorative 'pimp')."}, {"id": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_animales_zoomorphic_idioms", "label": "Animales\u20221: Zoomorphic Comparison Idioms", "file_type": "concept", "source_file": "established/085_vocabulario_activo_2_intermedio_avanzado.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_verbos_near_synonym_discrimination", "label": "Verbos: Near-Synonym Discrimination Set (tocar/jugar, saber/conocer/poder, etc.)", "file_type": "concept", "source_file": "established/085_vocabulario_activo_2_intermedio_avanzado.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_cada_oveja_categorization", "label": "Cada Oveja con su Pareja: Semantic Categorization Exercise (Book 2)", "file_type": "concept", "source_file": "established/085_vocabulario_activo_2_intermedio_avanzado.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_la_television_units", "label": "La Televisi\u00f3n\u20221/2: Parts, Procedural, Genre-Taxonomy, and Colloquial Media Vocabulary", "file_type": "concept", "source_file": "established/085_vocabulario_activo_2_intermedio_avanzado.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_el_coche_procedural_sequence", "label": "El Coche: Full Procedural Driving-Action Sequence", "file_type": "concept", "source_file": "established/085_vocabulario_activo_2_intermedio_avanzado.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_carro_coche_semantic_drift", "label": "Carro/Coche Diachronic Semantic Drift (Cart \u2192 Car)", "file_type": "concept", "source_file": "established/085_vocabulario_activo_2_intermedio_avanzado.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Here 'carro' means an old-fashioned horse-drawn cart (opposed to modern 'coche'), the reverse of the value 'carro' carries in established/083's dialectal car-vocabulary chapter, where Latin American varieties (Argentina, Mexico) generalized the same root to mean 'car' instead of peninsular 'coche' \u2014 together sketching a plausible diachronic bridge (cart \u2192 car) along a wheeled-vehicle conceptual axis that took different outcomes in different dialect regions."}], "edges": [{"source": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_book", "target": "datasets_spanish_established_085_vocabulario_activo_2_intermedio_avanzado_refranes_proverbs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/085_vocabulario_activo_2_intermedio_avanzado.md", "source_location": null, "weight": 1.0}, {"