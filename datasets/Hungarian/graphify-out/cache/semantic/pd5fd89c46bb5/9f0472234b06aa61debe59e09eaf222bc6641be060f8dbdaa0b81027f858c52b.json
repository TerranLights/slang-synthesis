cing, sibilant, pre-j gemination, v-assimilation)", "nodes": ["datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_voicing_devoicing_assimilation", "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_sibilant_assimilation", "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_consonant_lengthening_before_j", "datasets_hungarian_established_003_chapter6_case_system_v_assimilation_instrumental_translative"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md"}]}