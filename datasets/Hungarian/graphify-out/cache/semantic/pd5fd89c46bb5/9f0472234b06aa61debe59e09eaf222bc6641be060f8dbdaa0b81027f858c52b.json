{"nodes": [{"id": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_doc", "label": "Chapters 1-3: Phonology and Vowel Harmony", "file_type": "document", "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_vowel_harmony", "label": "Vowel Harmony", "file_type": "rationale", "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Suffixes carry front/back (and rounded/unrounded) vowel allomorphs because Hungarian requires front-or-back vowel assonance to be maintained across an entire native word; the suffix's vowel changes shape to agree with the stem's own vowel class rather than the reverse, which is why case, plural, and possessive paradigms each have 2-3 allomorphs."}, {"id": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_neutral_vowels", "label": "Neutral Vowels in Vowel Harmony", "file_type": "rationale", "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Front unrounded vowels (i, i, e, e-acute) carry no inherent front/back marking and co-occur with either class, so a mixed back+neutral stem defaults to back and an all-neutral stem defaults to front (with lexically memorized exceptions, e.g. verb root sziv 'inhale') because neutral vowels alone give the harmony system no positive evidence for a suffix variant."}, {"id": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_consonant_length", "label": "Consonant Length (Gemination)", "file_type": "rationale", "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consonant length is phonemic in Hungarian (szeretem 'I love' vs szerettem 'I loved' differ only by length) because it functions as a genuine segmental contrast rather than an allophonic detail, so morphological processes producing long consonants are treated as meaningful outputs, not spelling quirks."}, {"id": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_consonant_lengthening_before_j", "label": "Consonant Lengthening Before j", "file_type": "rationale", "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "d/gy/t/ty/n/ny lengthen rather than surface as clusters before a j-initial suffix because Hungarian resolves these obstruent+j sequences via regressive place assimilation into one long palatal consonant; l instead fully assimilates to long jj, which is why Rounds flags it as the one deviation within the same rule."}, {"id": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_voicing_devoicing_assimilation", "label": "Voicing and Devoicing Assimilation", "file_type": "rationale", "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hungarian obstruents assimilate in voicing to whichever consonant follows across a morpheme/word boundary because voicing agreement is enforced regressively; v never triggers voicing (though it can itself devoice) and h has no voiced counterpart, which is why those two consonants sit outside the normal voiced/unvoiced pairing."}, {"id": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_sibilant_assimilation", "label": "Assimilation of Sibilants", "file_type": "rationale", "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hissing sibilants (sz, z) become hushing (s/zs-like) before a hushing sibilant because sibilant place-of-articulation assimilates regressively just as voicing does, producing a long hushing consonant; ordinary voicing/devoicing rules still apply on top since the two processes act on different features simultaneously."}, {"id": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_stress_and_intonation", "label": "Hungarian Stress and Intonation Rules", "file_type": "rationale", "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Word-initial stress is fixed and grammatically inert in Hungarian, so intonation rather than stress placement carries sentence-level distinctions - a rise-fall pitch pattern, not a stress shift, is the primary (sometimes only) signal distinguishing a declarative from a yes/no question reading of an otherwise identical sentence."}, {"id": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_szeretem_szerettem_pair", "label": "szeretem / szerettem minimal pair", "file_type": "concept", "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_adja_hagyja_mutatja_set", "label": "adja/hagyja/mutatja worked paradigm (lengthening before j)", "file_type": "concept", "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_asztalok_gyerekek_paradigm", "label": "asztalok/gyerekek/fuzetek/ismerosok/papirok five-stem harmony paradigm", "file_type": "concept", "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_doc", "target": "datasets_hungarian_00_book_triage_catalog_rounds_essential_grammar", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md", "source_location": null, "weight": 1.0}, {"source": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_doc", "target": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_vowel_harmony", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md", "source_location": null, "weight": 1.0}, {"source": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_doc", "target": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_neutral_vowels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md", "source_location": null, "weight": 1.0}, {"source": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_doc", "target": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_consonant_length", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/001_chapters1-3_phonology_vowel_harmony.md", "source_location": null, "weight": 1.0}, {"source": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_doc", "target": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmon