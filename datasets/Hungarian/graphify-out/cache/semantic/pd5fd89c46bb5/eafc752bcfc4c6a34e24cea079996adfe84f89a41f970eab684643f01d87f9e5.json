{"nodes": [{"id": "datasets_hungarian_established_002_chapter5_nouns_doc", "label": "Chapter 5: Nouns", "file_type": "document", "source_file": "established/002_chapter5_nouns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_hungarian_established_002_chapter5_nouns_article_system", "label": "Hungarian Article System (definite/indefinite/zero)", "file_type": "rationale", "source_file": "established/002_chapter5_nouns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hungarian requires the definite article in more environments than English (possessed nouns, possessive pronouns, demonstratives, many abstracts, generic reference) because the article's function has broadened beyond marking specific reference alone; it never inflects for case/number because it is not part of the noun's own agglutinative suffix chain."}, {"id": "datasets_hungarian_established_002_chapter5_nouns_agglutination_suffix_stacking", "label": "Agglutination / Suffix Stacking", "file_type": "rationale", "source_file": "established/002_chapter5_nouns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multiple suffixes (plural, possessive, case) stack on one noun stem, each contributing one independently identifiable piece of meaning, because Hungarian grammar is agglutinative rather than fusional; case sits outermost because it operates on the already fully-inflected word form, not the bare root."}, {"id": "datasets_hungarian_established_002_chapter5_nouns_noun_stem_classes", "label": "Hungarian Noun Stem Classes (vowel-final, low-vowel, v-stem, -alom/-elem, fleeting-vowel, regular)", "file_type": "rationale", "source_file": "established/002_chapter5_nouns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hungarian classifies nouns by how their stem behaves under suffixation because the bare nominative-singular citation form often hides the 'real' stem (e.g. lo vs lov-); the alternation is only revealed once a suffix, canonically the plural, is attached, so class membership has to be memorized rather than predicted from the singular alone."}, {"id": "datasets_hungarian_established_002_chapter5_nouns_singular_plural_usage_rules", "label": "Singular/Plural Usage Rules Beyond Count", "file_type": "rationale", "source_file": "established/002_chapter5_nouns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hungarian uses the singular where English uses the plural (after numerals, for naturally-paired body parts/accessories, for generic reference) because in each case the noun denotes a category or a counted unit rather than a set of discrete countable individuals - the numeral already carries plurality, and paired items are conceived of as one type-referent."}, {"id": "datasets_hungarian_established_002_chapter5_nouns_lovak_v_stem_example", "label": "lovak / lorol v-stem alternation example", "file_type": "concept", "source_file": "established/002_chapter5_nouns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "datasets_hungarian_established_002_chapter5_nouns_ismerosomhoz_baratnoideneknek_example", "label": "ismerosomhoz / baratnoideknek suffix-stacking examples", "file_type": "concept", "source_file": "established/002_chapter5_nouns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "datasets_hungarian_established_002_chapter5_nouns_doc", "target": "datasets_hungarian_00_book_triage_catalog_rounds_essential_grammar", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/002_chapter5_nouns.md", "source_location": null, "weight": 1.0}, {"source": "datasets_hungarian_established_002_chapter5_nouns_doc", "target": "datasets_hungarian_established_002_chapter5_nouns_article_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/002_chapter5_nouns.md", "source_location": null, "weight": 1.0}, {"source": "datasets_hungarian_established_002_chapter5_nouns_doc", "target": "datasets_hungarian_established_002_chapter5_nouns_agglutination_suffix_stacking", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/002_chapter5_nouns.md", "source_location": null, "weight": 1.0}, {"source": "datasets_hungarian_established_002_chapter5_nouns_doc", "target": "datasets_hungarian_established_002_chapter5_nouns_noun_stem_classes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/002_chapter5_nouns.md", "source_location": null, "weight": 1.0}, {"source": "datasets_hungarian_established_002_chapter5_nouns_doc", "target": "datasets_hungarian_established_002_chapter5_nouns_singular_plural_usage_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/002_chapter5_nouns.md", "source_location": null, "weight": 1.0}, {"source": "datasets_hungarian_established_002_chapter5_nouns_doc", "target": "datasets_hungarian_established_002_chapter5_nouns_lovak_v_stem_example", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/002_chapter5_nouns.md", "source_location": null, "weight": 1.0}, {"source": "datasets_hungarian_established_002_chapter5_nouns_doc", "target": "datasets_hungarian_established_002_chapter5_nouns_ismerosomhoz_baratnoideneknek_example", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/002_chapter5_nouns.md", "source_location": null, "weight": 1.0}, {"source": "datasets_hungarian_established_002_chapter5_nouns_lovak_v_stem_example", "target": "datasets_hungarian_established_002_chapter5_nouns_noun_stem_classes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/002_chapter5_nouns.md", "source_location": null, "weight": 1.0}, {"source": "datasets_hungarian_established_002_chapter5_nouns_ismerosomhoz_baratnoideneknek_example", "target": "datasets_hungarian_established_002_chapter5_nouns_agglutination_suffix_stacking", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/002_chapter5_nouns.md", "source_location": null, "weight": 1.0}, {"source": "datasets_hungarian_established_002_chapter5_nouns_agglutination_suffix_stacking", "target": "datasets_hungarian_established_001_chapters1_3_phonology_vowel_harmony_vowel_harmony", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "established/002_chapter5_nouns.md", "source_location": null, "weight": 1.0}], "hyperedges": []}